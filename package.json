{
  "name": "biblia-game",
  "private": true,
  "scripts": {
    "build": "cd backend && npm install && npx prisma generate && cd ../web && npm install && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:web": "cd web && npm run dev",
    "db:push": "cd backend && npx prisma db push",
    "db:seed": "cd backend && npm run db:seed",
    "db:generate": "cd backend && npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "prisma": "^6.12.0",
    "typescript": "^5.7.3"
  }
}
