# Bíblia Game — Environment Variables
# Copie este arquivo para .env e preencha os valores

# ─── DATABASE (Supabase PostgreSQL) ─────────────────────
# Formato pooler (recomendado para serverless):
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Formato direct (para migrations locais):
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.vjcvzubnsorkrjtkwjqy:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# CRIT-05: DIRECT_URL necessário para Prisma (migrations)
DIRECT_URL="postgresql://postgres.vjcvzubnsorkrjtkwjqy:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET="mude-para-uma-string-segura-e-longa"
JWT_REFRESH_SECRET="mude-para-outra-string-segura-e-longa"

# ─── SERVER (apenas local) ──────────────────────────────
PORT=3001
CORS_ORIGIN="http://localhost:5180"

# ─── SUPABASE (para seed/debug, opcional) ────────────────
SUPABASE_URL="https://vjcvzubnsorkrjtkwjqy.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_wAV3x-8tFRk_yJGY4UoCpw__iV-XDpB"
